{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun-types", "node"],
    "allowJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "job-manager-system/**/*.ts",
    "telegram-notify/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}